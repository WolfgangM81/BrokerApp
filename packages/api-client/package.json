{
  "name": "@brokerapp/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript API client for BrokerApp. The schema types are generated from the FastAPI OpenAPI spec; the request helpers are hand-written.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../apps/api/openapi.json -o src/schema.ts --enum --immutable",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.2",
    "typescript": "^5.6.3"
  }
}
