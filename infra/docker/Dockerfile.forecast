# syntax=docker/dockerfile:1.10
# Forecast-worker image — Celery worker that consumes the `forecast` queue.
#
# Includes brokerapp-db, brokerapp-ml, and services/forecast. ML deps
# (LightGBM, XGBoost, statsmodels, MLflow, optionally Darts/Torch) live
# here and not in the ingest worker, so the ingest image stays small.
#
# Build context is the repo root.
# Build:  docker build -f infra/docker/Dockerfile.forecast -t brokerapp-forecast .

ARG PYTHON_VERSION=3.12-slim-bookworm

FROM python:${PYTHON_VERSION} AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.4.30 /uv /usr/local/bin/uv

# ---------- builder ----------
FROM base AS builder

# LightGBM and a few NumPy backends want a working OpenMP runtime; install
# libgomp1 in the runtime stage instead of forcing a fat builder. No
# TA-Lib here — forecast service uses indicators that come from features
# computed already by ingest, or via brokerapp-ml's pandas/Polars helpers
# that don't require TA-Lib at runtime.

COPY pyproject.toml /app/pyproject.toml
COPY services/db/pyproject.toml /app/services/db/pyproject.toml
COPY services/db/src /app/services/db/src
COPY services/forecast/pyproject.toml /app/services/forecast/pyproject.toml
COPY services/forecast/src /app/services/forecast/src
COPY ml/pyproject.toml /app/ml/pyproject.toml
COPY ml/src /app/ml/src

RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv /app/.venv && \
    uv pip install --python /app/.venv/bin/python \
        /app/services/db /app/ml /app/services/forecast

# ---------- runtime ----------
FROM python:${PYTHON_VERSION} AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:${PATH}" \
    PYTHONPATH=/app/src
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
      libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 1000 brokerapp \
    && useradd  --system --uid 1000 --gid brokerapp --no-create-home brokerapp

COPY --from=builder /app/.venv /app/.venv
COPY services/forecast/src /app/src

USER brokerapp

CMD ["celery", "-A", "forecast.celery_app:celery_app", "worker", \
     "--loglevel=INFO", "--concurrency=2", "--queues=forecast"]
