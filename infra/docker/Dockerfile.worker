# syntax=docker/dockerfile:1.10
# Multi-stage build for the Celery worker (services/ingest).
#
# Build context is the repo root.
# Build:  docker build -f infra/docker/Dockerfile.worker -t brokerapp-worker .

ARG PYTHON_VERSION=3.12-slim-bookworm

FROM python:${PYTHON_VERSION} AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.4.30 /uv /usr/local/bin/uv

# ---------- builder ----------
FROM base AS builder

# Build deps: TA-Lib C library headers + build toolchain.
# See ADR-0007 for why we use TA-Lib (vs pandas-ta / ta).
ARG TALIB_VERSION=0.6.4
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
    && curl -fsSL "https://github.com/ta-lib/ta-lib/releases/download/v${TALIB_VERSION}/ta-lib-${TALIB_VERSION}-src.tar.gz" -o /tmp/ta-lib.tgz \
    && tar -xzf /tmp/ta-lib.tgz -C /tmp \
    && cd "/tmp/ta-lib-${TALIB_VERSION}" \
    && ./configure --prefix=/usr/local \
    && make -j"$(nproc)" \
    && make install \
    && ldconfig \
    && rm -rf /tmp/ta-lib* \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml /app/pyproject.toml
COPY services/ingest/pyproject.toml /app/services/ingest/pyproject.toml
COPY services/ingest/src /app/services/ingest/src

RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv /app/.venv && \
    uv pip install --python /app/.venv/bin/python /app/services/ingest

# ---------- runtime ----------
FROM python:${PYTHON_VERSION} AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:${PATH}" \
    PYTHONPATH=/app/src
WORKDIR /app

RUN groupadd --system --gid 1000 brokerapp && \
    useradd  --system --uid 1000 --gid brokerapp --no-create-home brokerapp

# Runtime needs the TA-Lib shared library (no headers / build tools).
COPY --from=builder /usr/local/lib/libta* /usr/local/lib/
COPY --from=builder /usr/local/lib/pkgconfig/ta-lib.pc /usr/local/lib/pkgconfig/ta-lib.pc
RUN ldconfig

COPY --from=builder /app/.venv /app/.venv
COPY services/ingest/src /app/src

USER brokerapp

CMD ["celery", "-A", "ingest.celery_app:celery_app", "worker", "--loglevel=INFO", "--concurrency=2"]
