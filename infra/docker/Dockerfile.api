# syntax=docker/dockerfile:1.10
# Multi-stage build for the FastAPI gateway.
#
# Build context is the repo root (so we can copy uv workspace metadata).
# Build:  docker build -f infra/docker/Dockerfile.api -t brokerapp-api .

ARG PYTHON_VERSION=3.12-slim-bookworm

FROM python:${PYTHON_VERSION} AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
WORKDIR /app

# uv from official image (small, deterministic).
COPY --from=ghcr.io/astral-sh/uv:0.4.30 /uv /usr/local/bin/uv

# ---------- builder ----------
FROM base AS builder

# Workspace metadata first for caching.
COPY pyproject.toml /app/pyproject.toml
COPY apps/api/pyproject.toml /app/apps/api/pyproject.toml

# Install only the api package and its deps into a project-local venv.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv /app/.venv && \
    uv pip install --python /app/.venv/bin/python --no-deps fastapi uvicorn

# Copy source and install the package itself.
COPY apps/api/src /app/apps/api/src
COPY apps/api/pyproject.toml /app/apps/api/pyproject.toml
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /app/.venv/bin/python /app/apps/api

# ---------- runtime ----------
FROM python:${PYTHON_VERSION} AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:${PATH}"
WORKDIR /app

# Non-root user.
RUN groupadd --system --gid 1000 brokerapp && \
    useradd  --system --uid 1000 --gid brokerapp --no-create-home brokerapp

COPY --from=builder /app/.venv /app/.venv
COPY apps/api/src /app/src

USER brokerapp
EXPOSE 8000
ENV PYTHONPATH=/app/src

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys;sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz',timeout=3).status==200 else 1)"

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
