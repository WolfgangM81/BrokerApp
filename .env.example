# Local development environment variables.
# Copy to .env and adjust as needed. .env is gitignored.

# --- Postgres / TimescaleDB ---
POSTGRES_USER=brokerapp
POSTGRES_PASSWORD=brokerapp
POSTGRES_DB=brokerapp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=brokerapp
MINIO_ROOT_PASSWORD=brokerapp123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000

# --- MLflow ---
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:3000

# --- Auth (Authentik OIDC) ---
# Set these from your Authentik application configuration.
AUTHENTIK_ISSUER=https://auth.orbiter/application/o/brokerapp/
AUTHENTIK_AUDIENCE=brokerapp
AUTHENTIK_JWKS_URL=https://auth.orbiter/application/o/brokerapp/jwks/

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
AUTH_SECRET=change-me-locally
AUTH_AUTHENTIK_ID=brokerapp
AUTH_AUTHENTIK_SECRET=change-me-locally
AUTH_AUTHENTIK_ISSUER=https://auth.orbiter/application/o/brokerapp/

# --- Mail (MailHog locally) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
